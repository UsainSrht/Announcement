<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.usainsrht</groupId>
        <artifactId>announcement-parent</artifactId>
        <version>2.0</version>
    </parent>
    <artifactId>announcement</artifactId>
    <packaging>jar</packaging>
    <name>Announcement</name>
    <description>Announcement plugin/mod: Spigot, Paper, Purpur, Folia, Fabric, Forge and NeoForge in one jar.</description>

    <dependencies>
        <dependency><groupId>me.usainsrht</groupId><artifactId>announcement-core</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>me.usainsrht</groupId><artifactId>announcement-paper</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>me.usainsrht</groupId><artifactId>announcement-bukkit</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>me.usainsrht</groupId><artifactId>announcement-mod</artifactId><version>${project.version}</version></dependency>
    </dependencies>

    <build>
        <finalName>Announcement-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>fabric.mod.json</include>
                    <include>META-INF/mods.toml</include>
                    <include>META-INF/neoforge.mods.toml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>fabric.mod.json</exclude>
                    <exclude>META-INF/mods.toml</exclude>
                    <exclude>META-INF/neoforge.mods.toml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>me.usainsrht:*</include>
                                    <include>org.bstats:*</include>
                                    <include>space.arim.morepaperlib:morepaperlib</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>me.usainsrht.announcement.lib.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>space.arim.morepaperlib</pattern>
                                    <shadedPattern>me.usainsrht.announcement.lib.morepaperlib</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Automatic-Module-Name>announcement</Automatic-Module-Name>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
